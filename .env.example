# ---- copy to .env and fill in (never commit .env) ----

# YouTube Data API v3 key (Google Cloud Console)
YT_API_KEY=

# MLflow tracking (free remote: create a repo on Dagshub -> copy its MLflow URI)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Serving overrides (optional; sensible defaults exist)
MODEL_VERSION=
MODEL_PATH=
DB_PATH=
CACHE_SIZE=
RATE_LIMIT_PER_MIN=
