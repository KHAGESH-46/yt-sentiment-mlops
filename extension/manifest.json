{
  "manifest_version": 3,
  "name": "YT Comment Sentiment",
  "version": "0.2.2",
  "description": "Real-time sentiment badges next to YouTube comments.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.e2b.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selectors.json"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}
